# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DEBUG=false

# SellAuth - Account > Developers / Storefront > Configure > Miscellaneous
SELLAUTH_API_KEY=
SELLAUTH_SHOP_ID=
SELLAUTH_WEBHOOK_SECRET=
SELLAUTH_WEBHOOK_HOST=0.0.0.0
SELLAUTH_WEBHOOK_PORT=8790

# Local dashboard API
DASHBOARD_TOKEN=
DASHBOARD_API_PORT=8787
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_NIVEL_MINIMO=3

# Vigilancia (opcional pero muy recomendable)
# Webhook de Discord a un canal privado de staff: caidas, reinicios y arranques degradados.
ALERT_WEBHOOK_URL=
# Monitor externo (healthchecks.io, Uptime Kuma). La ausencia de ping delata que el proceso murio.
HEALTHCHECK_URL=
# Ruta al binario de Chromium si no esta en una ubicacion estandar (tablon de stock).
CHROMIUM_PATH=
