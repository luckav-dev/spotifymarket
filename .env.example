# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DEBUG=false

# Spotify Market web commerce layer
# Use the same value as SPOTIFY_MARKET_BOT_API_SECRET in Vercel.
SPOTIFY_MARKET_API_SECRET=
SPOTIFY_MARKET_API_URL=https://spotifymarket.xyz/api/bot
SPOTIFY_MARKET_WEB_URL=https://spotifymarket.xyz

# SellAuth remains the backend of the web and the source of webhook signatures.
# The bot falls back to these direct API credentials only until the Spotify
# Market API secret above is configured.
SELLAUTH_API_KEY=
SELLAUTH_SHOP_ID=
SELLAUTH_WEBHOOK_SECRET=
SELLAUTH_WEBHOOK_HOST=0.0.0.0
SELLAUTH_WEBHOOK_PORT=8790

# Local dashboard API
DASHBOARD_TOKEN=
DASHBOARD_API_PORT=8787
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_NIVEL_MINIMO=3
